# BYOK: API keys (optional if users provide their own)
# OpenRouter - get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Google AI Studio - get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_key_here

# App URL (optional, defaults to localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub personal access token with public_repo read scope
GITHUB_TOKEN=
